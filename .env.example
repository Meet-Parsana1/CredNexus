# ==============================================================================
# CredNexus — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel production, configure these variables in:
# Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE (PUBLIC)
# ------------------------------------------------------------------------------
# Base canonical URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Name displayed across metadata and header
NEXT_PUBLIC_APP_NAME="CredNexus"

# Default localization language code (en, hi, bn, mr, te, ta, gu, ur, kn, or, ml, pa)
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Default initial coordinates for Indian map centering (Lat, Lng)
NEXT_PUBLIC_MAP_DEFAULT_LAT="20.5937"
NEXT_PUBLIC_MAP_DEFAULT_LNG="78.9629"

# ------------------------------------------------------------------------------
# 2. PERSISTENT STORAGE (SERVER SECRET)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (Vercel Postgres, Neon, or Supabase)
# If omitted in local dev, the app reads the verified static snapshot from /data.
# Live scraper writes and sync state on Vercel require this variable.
DATABASE_URL="postgresql://user:password@hostname:5432/crednexus?sslmode=require"

# ------------------------------------------------------------------------------
# 3. SCRAPER & ADMIN SECURITY (SERVER SECRET)
# ------------------------------------------------------------------------------
# Secret token used by Vercel Cron or automated schedulers to trigger /api/admin/sync
# Generate with: openssl rand -hex 32
CRON_SECRET="your_generated_cron_secret_here"

# Secret key for manual admin API endpoints
ADMIN_SECRET_KEY="your_generated_admin_secret_key_here"

# ------------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL SERVICES (PUBLIC / SECRET)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API Key (OPTIONAL)
# NOTE: CredNexus uses OpenStreetMap + Leaflet for in-app mapping and native
# Google Maps deep-links for navigation, which operate 100% FREE without an API key.
# Only provide this if you explicitly switch the in-app map renderer to Google Maps JS.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
